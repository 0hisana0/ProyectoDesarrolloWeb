<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> | RedSocial</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Inter', sans-serif;
    background: #f5f5f5;
    color: #1a1a1a;
    min-height: 100vh;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.8rem 2rem;
    background: #ffffff;
    border-bottom: 1px solid #e0e0e0;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  nav .logo {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #6366f1;
    text-decoration: none;
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  nav ul a {
    font-size: 0.85rem;
    font-weight: 500;
    color: #555;
    text-decoration: none;
    transition: color 0.2s;
  }

  nav ul a:hover {
    color: #6366f1;
  }

  .nav-user {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .nav-user a {
    font-size: 0.85rem;
    font-weight: 500;
    color: #555;
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-user a:hover {
    color: #6366f1;
  }

  .avatar-sm {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #e0e0e0;
  }

  .avatar-fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #6366f1;
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    flex-shrink: 0;
  }

  .btn-logout {
    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;
    padding: 0.4rem 0.9rem;
    background: transparent;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    color: #888;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }

  .btn-logout:hover {
    color: #ef4444;
    border-color: #ef4444;
  }

  .btn-nav-login {
    font-size: 0.85rem;
    padding: 0.4rem 1rem;
    background: #6366f1;
    border: none;
    border-radius: 6px;
    color: #fff;
    text-decoration: none;
    font-weight: 500;
    transition: background 0.2s;
  }

  .btn-nav-login:hover {
    background: #4f46e5;
  }

  main {
    max-width: 680px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .page-header {
    margin-bottom: 1.5rem;
  }

  .page-header h1 {
    font-size: 1.5rem;
    font-weight: 700;
  }

  .card {
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 10px;
    padding: 1.2rem;
    margin-bottom: 1rem;
    transition: box-shadow 0.2s;
  }

  .card:hover {
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.8rem;
  }

  .card-header .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #e0e0e0;
  }

  .card-header .meta {
    flex: 1;
  }

  .card-header .meta .nombre {
    font-weight: 600;
    font-size: 0.9rem;
    color: #1a1a1a;
    text-decoration: none;
  }

  .card-header .meta .nombre:hover {
    color: #6366f1;
  }

  .card-header .meta .fecha {
    font-size: 0.75rem;
    color: #999;
  }

  .card-body {
    margin-bottom: 0.8rem;
  }

  .card-body p {
    font-size: 0.95rem;
    line-height: 1.5;
    color: #333;
    white-space: pre-wrap;
  }

  .card-body img {
    max-width: 100%;
    border-radius: 8px;
    margin-top: 0.8rem;
  }

  .card-actions {
    display: flex;
    gap: 1rem;
    padding-top: 0.8rem;
    border-top: 1px solid #f0f0f0;
  }

  .action-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: #888;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    transition: background 0.2s, color 0.2s;
  }

  .action-btn:hover {
    background: #f5f5f5;
    color: #6366f1;
  }

  .action-btn.reaccionado {
    color: #6366f1;
    font-weight: 600;
  }

  .comentarios-section {
    margin-top: 0.8rem;
    padding-top: 0.8rem;
    border-top: 1px solid #f0f0f0;
  }

  .comentario {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
    padding: 0.5rem;
    background: #fafafa;
    border-radius: 8px;
  }

  .comentario .avatar-mini {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
  }

  .comentario .comentario-body {
    flex: 1;
  }

  .comentario .comentario-body .nombre {
    font-size: 0.8rem;
    font-weight: 600;
    color: #1a1a1a;
    text-decoration: none;
  }

  .comentario .comentario-body .texto {
    font-size: 0.85rem;
    color: #444;
    margin-top: 0.1rem;
  }

  .comentario .comentario-body .fecha {
    font-size: 0.7rem;
    color: #aaa;
  }

  .comentario-form {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .comentario-form input {
    flex: 1;
    padding: 0.5rem 0.8rem;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    font-size: 0.85rem;
    outline: none;
    transition: border-color 0.2s;
  }

  .comentario-form input:focus {
    border-color: #6366f1;
  }

  .comentario-form button {
    padding: 0.5rem 1rem;
    background: #6366f1;
    color: #fff;
    border: none;
    border-radius: 6px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.2s;
  }

  .comentario-form button:hover {
    background: #4f46e5;
  }

  .btn {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    padding: 0.5rem 1.2rem;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 500;
    transition: background 0.2s, transform 0.1s;
    text-decoration: none;
    display: inline-block;
  }

  .btn-primary {
    background: #6366f1;
    color: #fff;
  }

  .btn-primary:hover {
    background: #4f46e5;
  }

  .btn-secondary {
    background: #f0f0f0;
    color: #555;
  }

  .btn-secondary:hover {
    background: #e0e0e0;
  }

  .btn-danger {
    background: #fef2f2;
    color: #ef4444;
    border: 1px solid #fecaca;
  }

  .btn-danger:hover {
    background: #fee2e2;
  }

  .btn-sm {
    font-size: 0.78rem;
    padding: 0.3rem 0.8rem;
  }

  .form-box {
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 10px;
    padding: 1.5rem;
  }

  .form-group {
    margin-bottom: 1rem;
  }

  .form-group label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: #555;
    margin-bottom: 0.4rem;
  }

  .form-group input,
  .form-group textarea,
  .form-group select {
    width: 100%;
    padding: 0.6rem 0.8rem;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    font-size: 0.9rem;
    font-family: 'Inter', sans-serif;
    outline: none;
    transition: border-color 0.2s;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: #6366f1;
  }

  .form-group textarea {
    resize: vertical;
    min-height: 100px;
  }

  .form-actions {
    display: flex;
    gap: 0.8rem;
    margin-top: 1rem;
  }

  .alert {
    font-size: 0.85rem;
    padding: 0.8rem 1rem;
    border-radius: 8px;
    margin-bottom: 1rem;
  }

  .alert-error {
    background: #fef2f2;
    color: #ef4444;
    border: 1px solid #fecaca;
  }

  .alert-success {
    background: #f0fdf4;
    color: #22c55e;
    border: 1px solid #bbf7d0;
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: #999;
  }

  .empty-state p {
    font-size: 0.9rem;
  }

  .profile-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem;
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 10px;
    margin-bottom: 1.5rem;
  }

  .profile-header .avatar-large {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #e0e0e0;
  }

  .profile-header .profile-info h2 {
    font-size: 1.3rem;
    font-weight: 700;
  }

  .profile-header .profile-info .bio {
    font-size: 0.85rem;
    color: #666;
    margin-top: 0.3rem;
  }

  .profile-header .profile-info .email {
    font-size: 0.8rem;
    color: #aaa;
  }

  .create-post-box {
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 10px;
    padding: 1rem;
    margin-bottom: 1.5rem;
  }

  .create-post-box textarea {
    width: 100%;
    border: none;
    outline: none;
    font-size: 0.95rem;
    font-family: 'Inter', sans-serif;
    resize: none;
    min-height: 60px;
    padding: 0.5rem;
  }

  .create-post-box .post-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.8rem;
    border-top: 1px solid #f0f0f0;
  }

  footer {
    border-top: 1px solid #e0e0e0;
    padding: 1.5rem 2rem;
    font-size: 0.78rem;
    color: #aaa;
    text-align: center;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('img[src*="/uploads/"]').forEach(img => {
      img.addEventListener('error', () => {
        img.style.display = 'none'
        const fallback = document.createElement('span')
        fallback.className = 'avatar-fallback'
        fallback.textContent = img.getAttribute('data-inicial') || '?'
        img.parentNode.insertBefore(fallback, img.nextSibling)
      })
    })
  })

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') {
      fetch('/api/check-session', { method: 'GET' })
        .then(res => {
          if (res.status === 401) {
            window.location.replace('/login')
          }
        })
        .catch(() => {
          window.location.replace('/login')
        })
    }
  })
</script>
