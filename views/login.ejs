<!DOCTYPE html>
<html lang="es">

<head>
  <%- include('partials/head', { title: 'Iniciar Sesión' }) %>
    <style>
      .auth-wrapper {
        min-height: calc(100vh - 60px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 1rem;
      }

      .auth-box {
        width: 100%;
        max-width: 420px;
      }

      .auth-header {
        margin-bottom: 2rem;
      }

      .auth-header .label {
        font-family: 'Space Mono', monospace;
        font-size: 0.72rem;
        color: #c8f04a;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        margin-bottom: 0.8rem;
      }

      .auth-header h1 {
        font-size: 2.2rem;
        font-weight: 800;
        line-height: 1.1;
      }

      .auth-header h1 span {
        color: #c8f04a;
      }

      .auth-footer-link {
        font-family: 'Space Mono', monospace;
        font-size: 0.72rem;
        color: #555;
        margin-top: 1.5rem;
        text-align: center;
      }

      .auth-footer-link a {
        color: #c8f04a;
        text-decoration: none;
      }

      .auth-footer-link a:hover {
        text-decoration: underline;
      }
    </style>
</head>

<body>

  <%- include('partials/navbar', { currentPath: '/login' }) %>

    <div class="auth-wrapper">
      <div class="auth-box">

        <div class="auth-header">
          <p class="label">Acceso al sistema</p>
          <h1>Iniciar <span>Sesión</span></h1>
        </div>

        <% if (typeof error !=='undefined' && error) { %>
          <div class="alert alert-error">
            <%= error %>
          </div>
          <% } %>

            <div class="form-box">
              <div class="form-group">
                <label for="email">EMAIL</label>
                <input type="email" id="email" name="email" placeholder="correo@ejemplo.com" autocomplete="email">
              </div>

              <div class="form-group">
                <label for="password">CONTRASEÑA</label>
                <input type="password" id="password" name="password" placeholder="••••••••"
                  autocomplete="current-password">
              </div>

              <div class="form-actions">
                <button class="btn btn-primary" id="btn-login">ENTRAR →</button>
              </div>
            </div>

            <p class="auth-footer-link">
              ¿No tienes cuenta? <a href="/register">Regístrate aquí</a>
            </p>

      </div>
    </div>

    <footer>© 2651 CURSOSDB — TODOS LOS DERECHOS RESERVADOS</footer>

    <script>
      document.getElementById('btn-login').addEventListener('click', async () => {
        const btn = document.getElementById('btn-login')
        const email = document.getElementById('email').value.trim()
        const password = document.getElementById('password').value

        btn.disabled = true
        btn.textContent = 'VERIFICANDO...'

        const res = await fetch('/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password })
        })

        if (res.ok) {
          window.location.href = '/'
        } else {
          const data = await res.json()
          // Re-renderizar con error recargando o mostrar alerta inline
          showError(data.error ?? 'Credenciales incorrectas')
          btn.disabled = false
          btn.textContent = 'ENTRAR →'
        }
      })

      function showError(msg) {
        let alert = document.querySelector('.alert-error')
        if (!alert) {
          alert = document.createElement('div')
          alert.className = 'alert alert-error'
          document.querySelector('.auth-box').insertBefore(alert, document.querySelector('.form-box'))
        }
        alert.textContent = msg
      }
    </script>

</body>

</html>