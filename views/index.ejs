<!DOCTYPE html>
<html lang="es">

<head>
  <%- include('partials/head', { title: 'Inicio' }) %>
    <style>
      .hero {
        padding: 6rem 0 4rem;
        border-bottom: 1px solid #1e1e1e;
        margin-bottom: 3rem;
      }

      .hero .label {
        font-family: 'Space Mono', monospace;
        font-size: 0.72rem;
        color: #c8f04a;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        margin-bottom: 1.2rem;
      }

      .hero h1 {
        font-size: clamp(2.8rem, 6vw, 5rem);
        font-weight: 800;
        line-height: 1.05;
        max-width: 700px;
      }

      .hero h1 em {
        font-style: normal;
        color: #c8f04a;
      }

      .hero p {
        font-family: 'Space Mono', monospace;
        font-size: 0.82rem;
        color: #555;
        margin-top: 1.5rem;
        max-width: 480px;
        line-height: 1.7;
      }

      .hero-cta {
        display: inline-block;
        margin-top: 2.5rem;
        padding: 0.8rem 2rem;
        background: #c8f04a;
        color: #0f0f0f;
        font-family: 'Space Mono', monospace;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-decoration: none;
        border-radius: 2px;
        transition: opacity 0.2s;
      }

      .hero-cta:hover {
        opacity: 0.85;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        background: #2a2a2a;
        border: 1px solid #2a2a2a;
        border-radius: 4px;
        overflow: hidden;
      }

      .stat {
        background: #161616;
        padding: 1.8rem 2rem;
      }

      .stat .num {
        font-size: 2.2rem;
        font-weight: 800;
        color: #e8e8e0;
        line-height: 1;
      }

      .stat .desc {
        font-family: 'Space Mono', monospace;
        font-size: 0.7rem;
        color: #555;
        margin-top: 0.4rem;
        letter-spacing: 0.05em;
      }
    </style>
</head>

<body>

  <%- include('partials/navbar', { currentPath: '/' }) %>

    <main>
      <section class="hero">
        <p class="label">Curso práctico · Desarrollo Web 2651</p>
        <h1>Aprende.<br><em>Construye.</em><br>Domina.</h1>
        <p>Explora cursos de programación, matemáticas y bases de datos. Contenido estructurado para todos los niveles.
        </p>
        <a href="/cursos-view" class="hero-cta">VER CURSOS →</a>
      </section>

      <div class="stats">
        <div class="stat">
          <div class="num">
            <%= totalProgramacion %>
          </div>
          <div class="desc">CURSOS DE PROGRAMACIÓN</div>
        </div>
        <div class="stat">
          <div class="num">
            <%= totalMatematicas %>
          </div>
          <div class="desc">CURSOS DE MATEMÁTICAS</div>
        </div>
        <div class="stat">
          <div class="num">
            <%= totalBD %>
          </div>
          <div class="desc">CURSOS DE BASES DE DATOS</div>
        </div>
      </div>
    </main>

    <footer>© 2651 CURSOSDB — TODOS LOS DERECHOS RESERVADOS</footer>

</body>

</html>