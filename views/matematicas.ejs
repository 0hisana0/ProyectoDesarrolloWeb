<!DOCTYPE html>
<html lang="es">

<head>
  <%- include('partials/head', { title: 'Matemáticas' }) %>
</head>

<body>

  <%- include('partials/navbar', { currentPath: '/cursos-view/matematicas' }) %>

    <main>
      <div class="page-header">
        <h1>Cursos de <span>Matemáticas</span></h1>
        <p>
          <% if (usuarioActual?.rol==='admin' ) { %>
            GESTIÓN COMPLETA — POST · PUT · DELETE
            <% } else { %>
              MODO LECTURA
              <% } %>
        </p>
      </div>

      <div id="alert-area"></div>

      <!-- TABLA -->
      <div class="section-header">
        <h2>Listado</h2>
      </div>

      <div class="table-wrap">
        <table id="tabla-cursos">
          <thead>
            <tr>
              <th>ID</th>
              <th>TÍTULO</th>
              <th>TEMA</th>
              <th>VISTAS</th>
              <th>NIVEL</th>
              <% if (usuarioActual?.rol==='admin' ) { %>
                <th>ACCIONES</th>
                <% } %>
            </tr>
          </thead>
          <tbody>
            <% cursos.forEach(curso=> { %>
              <tr id="fila-<%= curso.id %>">
                <td>
                  <%= curso.id %>
                </td>
                <td>
                  <%= curso.titulo %>
                </td>
                <td>
                  <%= curso.tema %>
                </td>
                <td>
                  <%= curso.vistas.toLocaleString() %>
                </td>
                <td>
                  <span class="badge badge-nivel-<%= curso.nivel %>">
                    <%= curso.nivel %>
                  </span>
                </td>
                <% if (usuarioActual?.rol==='admin' ) { %>
                  <td>
                    <div class="btn-group">
                      <button class="btn btn-edit" data-id="<%= curso.id %>" data-titulo="<%= curso.titulo %>"
                        data-tema="<%= curso.tema %>" data-vistas="<%= curso.vistas %>" data-nivel="<%= curso.nivel %>">
                        EDITAR
                      </button>
                      <button class="btn btn-delete" data-id="<%= curso.id %>">
                        ELIMINAR
                      </button>
                    </div>
                  </td>
                  <% } %>
              </tr>
              <% }) %>
          </tbody>
        </table>
      </div>

      <!-- FORMULARIOS Y SCRIPT solo para admin -->
      <% if (usuarioActual?.rol==='admin' ) { %>

        <hr style="border-color:#1e1e1e; margin: 2.5rem 0">

        <!-- FORMULARIO CREAR -->
        <div class="form-box" id="form-crear">
          <h2>Nuevo curso</h2>
          <div class="form-grid">
            <div class="form-group">
              <label for="titulo">TÍTULO</label>
              <input type="text" id="titulo" placeholder="Aprende Cálculo">
            </div>
            <div class="form-group">
              <label for="tema">TEMA</label>
              <input type="text" id="tema" placeholder="cálculo">
            </div>
            <div class="form-group">
              <label for="vistas">VISTAS</label>
              <input type="number" id="vistas" placeholder="0" min="0">
            </div>
            <div class="form-group">
              <label for="nivel">NIVEL</label>
              <select id="nivel">
                <option value="">— selecciona —</option>
                <option value="basico">básico</option>
                <option value="intermedio">intermedio</option>
                <option value="avanzado">avanzado</option>
              </select>
            </div>
          </div>
          <div class="form-actions">
            <button class="btn btn-primary" id="btn-crear">CREAR CURSO</button>
          </div>
        </div>

        <!-- FORMULARIO EDITAR (oculto) -->
        <div class="form-box" id="form-editar" style="display:none; margin-top:1.5rem">
          <h2>Editar curso <span id="edit-id-label" style="color:#c8f04a"></span></h2>
          <input type="hidden" id="edit-id">
          <div class="form-grid">
            <div class="form-group">
              <label for="edit-titulo">TÍTULO</label>
              <input type="text" id="edit-titulo">
            </div>
            <div class="form-group">
              <label for="edit-tema">TEMA</label>
              <input type="text" id="edit-tema">
            </div>
            <div class="form-group">
              <label for="edit-vistas">VISTAS</label>
              <input type="number" id="edit-vistas" min="0">
            </div>
            <div class="form-group">
              <label for="edit-nivel">NIVEL</label>
              <select id="edit-nivel">
                <option value="basico">básico</option>
                <option value="intermedio">intermedio</option>
                <option value="avanzado">avanzado</option>
              </select>
            </div>
          </div>
          <div class="form-actions">
            <button class="btn btn-primary" id="btn-guardar">GUARDAR CAMBIOS</button>
            <button class="btn btn-cancel" id="btn-cancelar">CANCELAR</button>
          </div>
        </div>

        <% } %>

    </main>

    <footer>© 2651 CURSOSDB — TODOS LOS DERECHOS RESERVADOS</footer>

    <% if (usuarioActual?.rol==='admin' ) { %>
      <script>
        const BASE = '/cursos/matematicas'

        // ── Utilidades ──────────────────────────────────────────────

        function mostrarAlerta(msg, tipo = 'success') {
          const area = document.getElementById('alert-area')
          area.innerHTML = `<div class="alert alert-${tipo}">${msg}</div>`
          setTimeout(() => area.innerHTML = '', 3500)
        }

        function crearFilaHTML(c) {
          const tr = document.createElement('tr')
          tr.id = `fila-${c.id}`
          tr.innerHTML = `
        <td>${c.id}</td>
        <td>${c.titulo}</td>
        <td>${c.tema}</td>
        <td>${c.vistas.toLocaleString()}</td>
        <td><span class="badge badge-nivel-${c.nivel}">${c.nivel}</span></td>
        <td>
          <div class="btn-group">
            <button class="btn btn-edit"
              data-id="${c.id}"
              data-titulo="${c.titulo}"
              data-tema="${c.tema}"
              data-vistas="${c.vistas}"
              data-nivel="${c.nivel}">EDITAR</button>
            <button class="btn btn-delete" data-id="${c.id}">ELIMINAR</button>
          </div>
        </td>`
          return tr
        }

        function limpiarFormCrear() {
          ['titulo', 'tema', 'vistas', 'nivel'].forEach(id => {
            document.getElementById(id).value = ''
          })
        }

        // ── POST ─────────────────────────────────────────────────────

        async function crearCurso() {
          const body = {
            titulo: document.getElementById('titulo').value.trim(),
            tema: document.getElementById('tema').value.trim(),
            vistas: Number(document.getElementById('vistas').value),
            nivel: document.getElementById('nivel').value
          }

          const res = await fetch(BASE, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
          })

          if (!res.ok) {
            const err = await res.json()
            return mostrarAlerta('Error: ' + (err.error?.join(', ') ?? res.statusText), 'error')
          }

          const nuevo = await res.json()
          document.querySelector('#tabla-cursos tbody').appendChild(crearFilaHTML(nuevo))
          mostrarAlerta(`Curso "${nuevo.titulo}" creado correctamente.`)
          limpiarFormCrear()
        }

        // ── PUT ──────────────────────────────────────────────────────

        function abrirEditar(btn) {
          const d = btn.dataset
          document.getElementById('edit-id').value = d.id
          document.getElementById('edit-id-label').textContent = `#${d.id}`
          document.getElementById('edit-titulo').value = d.titulo
          document.getElementById('edit-tema').value = d.tema
          document.getElementById('edit-vistas').value = d.vistas
          document.getElementById('edit-nivel').value = d.nivel
          document.getElementById('form-editar').style.display = 'block'
          document.getElementById('form-editar').scrollIntoView({ behavior: 'smooth', block: 'start' })
        }

        function cerrarEditar() {
          document.getElementById('form-editar').style.display = 'none'
        }

        async function actualizarCurso() {
          const id = document.getElementById('edit-id').value
          const body = {
            titulo: document.getElementById('edit-titulo').value.trim(),
            tema: document.getElementById('edit-tema').value.trim(),
            vistas: Number(document.getElementById('edit-vistas').value),
            nivel: document.getElementById('edit-nivel').value
          }

          const res = await fetch(`${BASE}/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
          })

          if (!res.ok) {
            const err = await res.json()
            return mostrarAlerta('Error: ' + (err.error?.join(', ') ?? res.statusText), 'error')
          }

          const c = await res.json()
          const fila = document.getElementById(`fila-${id}`)
          fila.children[1].textContent = c.titulo
          fila.children[2].textContent = c.tema
          fila.children[3].textContent = c.vistas.toLocaleString()
          fila.children[4].innerHTML = `<span class="badge badge-nivel-${c.nivel}">${c.nivel}</span>`

          const btnEdit = fila.querySelector('.btn-edit')
          Object.assign(btnEdit.dataset, {
            titulo: c.titulo,
            tema: c.tema,
            vistas: c.vistas,
            nivel: c.nivel
          })

          cerrarEditar()
          mostrarAlerta(`Curso #${id} actualizado correctamente.`)
        }

        // ── DELETE ───────────────────────────────────────────────────

        async function eliminarCurso(btn) {
          const id = btn.dataset.id
          if (!confirm(`¿Eliminar el curso #${id}?`)) return

          const res = await fetch(`${BASE}/${id}`, { method: 'DELETE' })

          if (!res.ok) {
            return mostrarAlerta('No se pudo eliminar el curso.', 'error')
          }

          document.getElementById(`fila-${id}`)?.remove()
          mostrarAlerta(`Curso #${id} eliminado.`)
        }

        // ── Event listeners ──────────────────────────────────────────

        document.getElementById('btn-crear')
          .addEventListener('click', crearCurso)

        document.getElementById('btn-guardar')
          .addEventListener('click', actualizarCurso)

        document.getElementById('btn-cancelar')
          .addEventListener('click', cerrarEditar)

        document.getElementById('tabla-cursos')
          .addEventListener('click', (e) => {
            const btnEdit = e.target.closest('.btn-edit')
            const btnDelete = e.target.closest('.btn-delete')
            if (btnEdit) abrirEditar(btnEdit)
            if (btnDelete) eliminarCurso(btnDelete)
          })
      </script>
      <% } %>

</body>

</html>